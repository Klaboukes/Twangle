<resources>
    <string name="mic_permission_title">Twangle trenger mikrofonen din</string>
    <string name="mic_permission_intro">For å stemme lytter Twangle til instrumentet ditt. Lyden analyseres på enheten og blir aldri tatt opp eller sendt noe sted.</string>
    <string name="mic_permission_rationale">Uten mikrofonen kan Twangle ikke høre strengene dine, så den kan ikke si om de er stemt. Lyden forlater aldri enheten.</string>
    <string name="mic_permission_settings_hint">Mikrofontilgang er slått av for Twangle. Åpne Innstillinger, trykk på Tillatelser og så Mikrofon, og velg «Tillat bare når appen er i bruk».</string>
    <string name="mic_permission_settings_hint_switch">Mikrofontilgang er slått av for Twangle. Åpne Innstillinger, trykk på Tillatelser og slå på Mikrofon.</string>
    <string name="mic_permission_without_mic">Metronomen og verktøyene under Øving virker uten mikrofon.</string>
    <string name="mic_permission_without_mic_metronome">Metronomen virker uten mikrofon.</string>
    <string name="mic_permission_allow">Tillat mikrofon</string>
    <string name="mic_permission_open_settings">Åpne innstillinger</string>

    <string name="error_mic_permission">Mikrofontilgangen ble slått av. Tillat den igjen for å fortsette å stemme.</string>
    <string name="error_mic_busy">En samtale eller en annen app bruker mikrofonen. Trykk på «Prøv igjen» når den er ledig.</string>
    <string name="error_mic_unavailable">Mikrofonen kunne ikke åpnes. Lukk andre apper som bruker den, og trykk på «Prøv igjen», eller start enheten på nytt.</string>
    <string name="error_mic_stopped">Mikrofonen stoppet, kanskje på grunn av en samtale eller en annen app. Trykk på «Prøv igjen» for å stemme videre.</string>
    <string name="error_retry">Prøv igjen</string>

