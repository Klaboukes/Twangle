<resources>
    <string name="mic_permission_title">Twangle-க்கு உங்கள் மைக்ரோஃபோன் தேவை</string>
    <string name="mic_permission_intro">ட்யூன் செய்ய, Twangle உங்கள் இசைக்கருவியைக் கேட்கிறது. ஒலி உங்கள் சாதனத்திலேயே ஆராயப்படுகிறது; அது ஒருபோதும் பதிவு செய்யப்படுவதோ எங்கும் அனுப்பப்படுவதோ இல்லை.</string>
    <string name="mic_permission_rationale">மைக்ரோஃபோன் இல்லாமல் Twangle-ஆல் உங்கள் கம்பிகளைக் கேட்க முடியாது, அதனால் அவை சுருதியில் உள்ளனவா என்று சொல்ல முடியாது. ஒலி ஒருபோதும் உங்கள் சாதனத்தை விட்டு வெளியேறாது.</string>
    <string name="mic_permission_settings_hint">Twangle-க்கு மைக்ரோஃபோன் அணுகல் முடக்கப்பட்டுள்ளது. அமைப்புகளைத் திறந்து, அனுமதிகள், பிறகு மைக்ரோஃபோன் என்பதைத் தட்டி, ஆப்ஸைப் பயன்படுத்தும்போது மட்டும் அனுமதிக்கவும்.</string>
    <string name="mic_permission_settings_hint_switch">Twangle-க்கு மைக்ரோஃபோன் அணுகல் முடக்கப்பட்டுள்ளது. அமைப்புகளைத் திறந்து, அனுமதிகள் என்பதைத் தட்டி, மைக்ரோஃபோனை இயக்கவும்.</string>
    <string name="mic_permission_without_mic">மெட்ரோனோமும் பயிற்சிக் கருவிகளும் மைக்ரோஃபோன் இல்லாமலே வேலை செய்யும்.</string>
    <string name="mic_permission_without_mic_metronome">மெட்ரோனோம் மைக்ரோஃபோன் இல்லாமலே வேலை செய்யும்.</string>
    <string name="mic_permission_allow">மைக்ரோஃபோனை அனுமதி</string>
    <string name="mic_permission_open_settings">அமைப்புகளைத் திற</string>

    <string name="error_mic_permission">மைக்ரோஃபோன் அணுகல் முடக்கப்பட்டது. தொடர்ந்து ட்யூன் செய்ய மீண்டும் அனுமதிக்கவும்.</string>
    <string name="error_mic_busy">அழைப்போ வேறொரு ஆப்ஸோ மைக்ரோஃபோனைப் பயன்படுத்துகிறது. அது விடுபட்டதும், மீண்டும் முயலவும் என்பதைத் தட்டவும்.</string>
    <string name="error_mic_unavailable">மைக்ரோஃபோனைத் திறக்க முடியவில்லை. அதைப் பயன்படுத்தும் பிற ஆப்ஸை மூடிவிட்டு மீண்டும் முயலவும் என்பதைத் தட்டவும், அல்லது சாதனத்தை மீண்டும் தொடங்கவும்.</string>
    <string name="error_mic_stopped">மைக்ரோஃபோன் நின்றுவிட்டது, ஒருவேளை அழைப்புக்காகவோ வேறொரு ஆப்ஸுக்காகவோ இருக்கலாம். தொடர்ந்து ட்யூன் செய்ய மீண்டும் முயலவும் என்பதைத் தட்டவும்.</string>
