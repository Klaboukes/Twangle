    <string name="mic_permission_open_settings">เปิดการตั้งค่า</string>

    <string name="error_mic_permission">การเข้าถึงไมโครโฟนถูกปิด อนุญาตอีกครั้งเพื่อจูนต่อ</string>
    <string name="error_mic_busy">การโทรหรือแอปอื่นกำลังใช้ไมโครโฟน เมื่อว่างแล้วแตะลองอีกครั้ง</string>
    <string name="error_mic_unavailable">เปิดไมโครโฟนไม่ได้ ปิดแอปอื่นที่ใช้ไมโครโฟนอยู่แล้วแตะลองอีกครั้ง หรือรีสตาร์ทอุปกรณ์</string>
