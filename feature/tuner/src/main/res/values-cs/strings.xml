<resources>

    <string name="mic_permission_title">Twangle potřebuje mikrofon</string>
    <string name="mic_permission_intro">Při ladění Twangle poslouchá tvůj nástroj. Zvuk se zpracovává v zařízení a nikdy se nenahrává ani nikam neodesílá.</string>
    <string name="mic_permission_rationale">Bez mikrofonu Twangle tvé struny neslyší, a tak nepozná, jestli jsou naladěné. Zvuk nikdy neopustí tvé zařízení.</string>
    <string name="mic_permission_settings_hint">Přístup k mikrofonu je pro Twangle vypnutý. Otevři Nastavení, klepni na Oprávnění, pak na Mikrofon a vyber Povolit, jen když se aplikace používá.</string>
    <string name="mic_permission_settings_hint_switch">Přístup k mikrofonu je pro Twangle vypnutý. Otevři Nastavení, klepni na Oprávnění a zapni Mikrofon.</string>
    <string name="mic_permission_without_mic">Metronom a vše ve Cvičení funguje i bez mikrofonu.</string>
    <string name="mic_permission_without_mic_metronome">Metronom funguje i bez mikrofonu.</string>
    <string name="mic_permission_allow">Povolit mikrofon</string>
    <string name="mic_permission_open_settings">Otevřít nastavení</string>

    <string name="error_mic_permission">Přístup k mikrofonu byl vypnut. Povol ho znovu, ať můžeš dál ladit.</string>
    <string name="error_mic_busy">Mikrofon používá hovor nebo jiná aplikace. Až bude volný, klepni na Zkusit znovu.</string>
    <string name="error_mic_unavailable">Mikrofon nešel otevřít. Zavři jiné aplikace, které ho používají, a klepni na Zkusit znovu, nebo restartuj zařízení.</string>
    <string name="error_mic_stopped">Mikrofon se zastavil, možná kvůli hovoru nebo jiné aplikaci. Klepni na Zkusit znovu a laď dál.</string>
    <string name="error_retry">Zkusit znovu</string>

