    <string name="practice_scale_type_phrygian_dominant">Phrygian dominant</string>
    <!-- Scales: the button for the Lydian mode scale, in a grid two to a row (a long name takes two lines). Musicians' usual name. -->
    <string name="practice_scale_type_lydian">Lydian</string>
    <!-- Scales: the button for the Mixolydian mode scale, in a grid two to a row (a long name takes two lines). Musicians' usual name. -->
    <string name="practice_scale_type_mixolydian">Mixolydian</string>
    <!-- Scales: the button for the Locrian mode scale, in a grid two to a row (a long name takes two lines). Musicians' usual name. -->
    <string name="practice_scale_type_locrian">Locrian</string>
    <!-- Scales: the button for the harmonic minor scale, in a grid two to a row (a long name takes two lines). Musicians' usual name. -->
    <string name="practice_scale_type_harmonic_minor">Harmonic minor</string>
    <!-- Scales: the button for the melodic minor scale, in a grid two to a row (a long name takes two lines). Musicians' usual name. -->
    <string name="practice_scale_type_melodic_minor">Melodic minor</string>
    <!-- A scale in words, on the name button (large, on one line where it fits) and for TalkBack. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_scale_major">%1$s major</string>
    <!-- Scales: the natural minor scale in words, on the name button (large, one line where it fits) and for TalkBack. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_scale_minor">%1$s minor</string>
    <!-- Scales: the major pentatonic scale in words, on the name button (large, one line where it fits) and for TalkBack. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_scale_major_pentatonic">%1$s major pentatonic</string>
    <!-- Scales: the minor pentatonic scale in words, on the name button (large, one line where it fits) and for TalkBack. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_scale_minor_pentatonic">%1$s minor pentatonic</string>
    <!-- Scales: the blues scale in words, on the name button (large, one line where it fits) and for TalkBack. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_scale_blues">%1$s blues</string>
    <!-- Scales: the major blues scale in words, on the name button (large, one line where it fits) and for TalkBack. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_scale_major_blues">%1$s major blues</string>
    <!-- Scales: the Dorian mode scale in words, on the name button (large, one line where it fits) and for TalkBack. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_scale_dorian">%1$s Dorian</string>
    <!-- Scales: the Phrygian mode scale in words, on the name button (large, one line where it fits) and for TalkBack. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_scale_phrygian">%1$s Phrygian</string>
    <!-- Scales: the Phrygian dominant scale in words, on the name button (large, one line where it fits) and for TalkBack. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_scale_phrygian_dominant">%1$s Phrygian dominant</string>
    <!-- Scales: the Lydian mode scale in words, on the name button (large, one line where it fits) and for TalkBack. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_scale_lydian">%1$s Lydian</string>
    <!-- Scales: the Mixolydian mode scale in words, on the name button (large, one line where it fits) and for TalkBack. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_scale_mixolydian">%1$s Mixolydian</string>
    <!-- Scales: the Locrian mode scale in words, on the name button (large, one line where it fits) and for TalkBack. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_scale_locrian">%1$s Locrian</string>
    <!-- Scales: the harmonic minor scale in words, on the name button (large, one line where it fits) and for TalkBack. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_scale_harmonic_minor">%1$s harmonic minor</string>
    <!-- Scales: the melodic minor scale in words, on the name button (large, one line where it fits) and for TalkBack. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_scale_melodic_minor">%1$s melodic minor</string>
    <!-- TalkBack, the neck: %1$s the scale in words ("A minor pentatonic"), %2$s its notes from the root ("A, C, D, E, G"). -->
    <string name="practice_spoken_scale_notes">%1$s, notes %2$s</string>
    <!-- TalkBack, each note on a string: open, or the fret %1$d and the note's name %2$s; the root's places add "root". -->
    <string name="practice_spoken_scale_open">open %1$s</string>
    <!-- TalkBack, a note of the scale on a string: %1$d the fret, %2$s the note's name ("fret 5 A"). -->
    <string name="practice_spoken_scale_fret">fret %1$d %2$s</string>
    <!-- TalkBack, a place of the scale's root note on the neck: %1$s is the place as said above ("fret 5 A"), then "root". -->
    <string name="practice_spoken_scale_root">%1$s, root</string>
    <!-- TalkBack, the neck: a place of the scale's colour note, ringed on the neck (Dorian's 6th, Lydian's ♯4 …). -->
    <string name="practice_spoken_scale_colour">%1$s, colour note</string>
    <!-- Capo helper (Phase 33): its name on its card in the Practice tab and in the "Last time" row. -->
    <string name="practice_tool_capo">Capo</string>
    <!-- Over the button that picks the chord shapes the player knows (C, D, E, G, A, Dm, Em, Am). -->
    <string name="practice_capo_shapes">Shapes I play</string>
    <!-- TalkBack, that button: %1$s the shapes picked in words ("C major"). -->
    <string name="practice_capo_shapes_spoken">Shapes I play: %1$s</string>
    <!-- Before the capo's fret number between the ‹ › buttons ("Capo 3"). -->
    <string name="practice_capo_label">Capo</string>
    <!-- TalkBack, the capo's fret: at 0, no capo on. -->
    <string name="practice_capo_none">No capo</string>
    <!-- TalkBack, the capo's fret: %1$d the fret (1 to 11). -->
    <string name="practice_capo_on_fret">Capo on fret %1$d</string>
    <!-- TalkBack, the ‹ and › buttons that move the capo one fret towards the nut or the body. -->
    <string name="practice_capo_lower">Capo one fret down</string>
    <!-- TalkBack name of the › button: moves the capo one fret towards the body (the note goes up). -->
    <string name="practice_capo_higher">Capo one fret up</string>
    <!-- The table's two column heads: the shape the player fingers, and the chord it sounds with the capo on. -->
    <string name="practice_capo_shape_column">Shape</string>
    <!-- Capo helper: the table's column head over the chord each shape sounds with the capo on. One short word. -->
    <string name="practice_capo_sounds_column">Sounds</string>
    <!-- Under the table: %1$s the key the song then sounds in ("E♭", "Cm"; TalkBack hears "E flat major"). -->
    <string name="practice_capo_sounds_in">Sounds in %1$s</string>
    <!-- TalkBack, a row of the table: %1$s the shape in words ("C major"), %2$s the chord it sounds ("E flat major"). -->
    <string name="practice_capo_row_spoken">%1$s shape, sounds %2$s</string>
    <!-- TalkBack, what a tap on a row does: it opens the shape in the Chords tool ("Double-tap to open in Chords"). -->
    <string name="practice_capo_open_chord">open in Chords</string>
    <!-- The drone under Scales (Phase 48), a steady low note on the scale's root: TalkBack's name for its panel. -->
    <string name="practice_drone">Drone</string>
    <!-- Chords: TalkBack's name for the round microphone button beside the chord's name; a tap listens, and each chord the player strums is named and charted. -->
    <string name="practice_chords_listen">Listen</string>
    <!-- TalkBack, the state of that Listen button while it listens to the chords strummed. -->
    <string name="practice_chords_listening">Listening</string>
    <!-- Chords: a short balloon by the Listen button (and its TalkBack state) when the microphone can't be used, for a call or another app; Listen has turned itself off. -->
    <string name="practice_chords_mic_busy">Microphone is busy</string>
    <!-- Chords: a short balloon by the Listen button (and its TalkBack state) when the app is no longer allowed to use the microphone (taken back in the phone's settings); Listen has turned itself off, and a tap on it asks for the microphone again. -->
    <string name="practice_chords_mic_off">Microphone is off</string>
    <!-- TalkBack, the ▶ / ■ half of the drone button. -->
    <string name="practice_drone_play">Play the drone</string>
    <!-- TalkBack, the ■ half of the drone button while the drone plays: stops it. -->
    <string name="practice_drone_stop">Stop the drone</string>
    <!-- TalkBack, the drone button's other half, which opens the drone panel: %1$s the sound picked ("Drone sound: Tanpura"). -->
    <string name="practice_drone_sound_spoken">Drone sound: %1$s</string>
    <!-- The drone panel: the sound's section, then its four sounds in this order (the instruments' common names). -->
    <string name="practice_drone_sound">Sound</string>
    <!-- Drone panel: sound of the tanpura (Indian drone lute). The instrument's common name. -->
    <string name="practice_drone_tanpura">Tanpura</string>
    <!-- Drone panel: sound of the harmonium (pump organ). The instrument's common name. -->
    <string name="practice_drone_harmonium">Harmonium</string>
    <!-- Drone panel: sound of a soft organ with flute pipes. -->
    <string name="practice_drone_flute_organ">Flute organ</string>
    <!-- Drone panel: a warm synthesizer pad sound (a soft, sustained synth chord). -->
    <string name="practice_drone_warm_pad">Warm pad</string>
    <!-- The drone panel: which notes sound: the scale's root alone, with its fifth, with its fifth and the octave above. -->
    <string name="practice_drone_notes">Notes</string>
    <!-- Drone panel, under Notes: only the scale's root note sounds. One short word. -->
    <string name="practice_drone_root">Root</string>
    <!-- Drone panel, under Notes: the root with its fifth. Short; keep the plus sign. -->
    <string name="practice_drone_fifth">+ fifth</string>
    <!-- Drone panel, under Notes: the root with its fifth and the octave above. Short; keep the plus sign. -->
    <string name="practice_drone_fifth_octave">+ fifth and octave</string>
    <!-- The drone panel's switch: the whole drone an octave lower. -->
    <string name="practice_drone_lower">Lower</string>
</resources>
