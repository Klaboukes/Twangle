# Gradle / build
.gradle/
build/
.kotlin/
captures/
.externalNativeBuild/
.cxx/

# Local config (sdk.dir, signing secrets)
local.properties
*.jks
*.keystore
keystore.properties
# The Google Play API key (a service-account JSON key) lives in ~/.twangle-keys/, never here.
play-service-account*.json

# IDE
.idea/
*.iml
.vscode/
.DS_Store

# Android
*.apk
*.aab

# Claude Code per-user settings (shared skills in .claude/skills ARE committed)
.claude/settings.local.json

# Play Store screenshots: made on the phone by scripts/store-screenshots.sh, uploaded by hand.
# The icon and feature graphic (scripts/store-graphics.sh) have no words and are small: committed.
fastlane/metadata/android/*/images/*
!fastlane/metadata/android/en-US/images/icon.png
!fastlane/metadata/android/en-US/images/featureGraphic.png

# Release bundles and their notes, made by scripts/release.sh bundle (docs/release.md)
/release/
