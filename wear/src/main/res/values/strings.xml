<resources>
    <string name="app_name" translatable="false">Twangle</string>
    <!-- Watch tuner: shown while no note is heard. -->
    <string name="wear_play_note">Play a note</string>
    <!-- Watch: how far the note is off without saying which way, small under the word "In tune" (and "0 cents" right on the note). %1$s is the number, e.g. "2". Also said by TalkBack for "0 cents". -->
    <plurals name="wear_cents">
        <item quantity="one">%1$s cent</item>
        <item quantity="other">%1$s cents</item>
    </plurals>
    <!-- Watch: what TalkBack says while the note is in tune (the arc turns green), after the note: "E 2, in tune". Lower case here; with a capital it is also the word under the note. -->
    <string name="wear_in_tune">in tune</string>
    <!-- Watch, TalkBack: the reading read aloud. %1$s is the note as said ("A sharp", in Dutch "ais"), %2$d its octave, %3$s how far off it is or "in tune", e.g. "A sharp 2, in tune". -->
    <string name="wear_spoken_reading">%1$s %2$d, %3$s</string>
    <!-- Watch, TalkBack: the same while the note is off, with the word under the note that says which way to turn the peg. %4$s is that word ("Tighten" or "Loosen"), e.g. "A sharp 2, 12 cents flat, Tighten". -->
    <string name="wear_spoken_reading_hint">%1$s %2$d, %3$s, %4$s</string>
    <!-- Watch: how far too low the note is, small under the word "Tighten", and in the reading TalkBack reads aloud. %1$d is how many cents (hundredths of a semitone). -->
    <plurals name="wear_spoken_cents_flat">
        <item quantity="one">%1$d cent flat</item>
        <item quantity="other">%1$d cents flat</item>
    </plurals>
    <!-- Watch: how far too high the note is, small under the word "Loosen", and in the reading TalkBack reads aloud. %1$d is how many cents. -->
    <plurals name="wear_spoken_cents_sharp">
        <item quantity="one">%1$d cent sharp</item>
        <item quantity="other">%1$d cents sharp</item>
    </plurals>
    <!-- Watch: the word under the note while the string is too low: turn its peg to tighten it (raise its pitch). One short word, imperative, starts with a capital (the phone's word under its tuner). Also said by TalkBack after the reading. -->
    <string name="wear_word_tighten">Tighten</string>
    <!-- Watch: the word under the note while the string is too high: turn its peg to loosen it (lower its pitch). One short word, imperative, starts with a capital. Also said by TalkBack. -->
    <string name="wear_word_loosen">Loosen</string>
    <!-- Watch, TalkBack: a note name with a sharp read aloud, e.g. "A sharp". %1$s is the letter or syllable ("A", "La"). In languages whose letter names are said in one word (Dutch ais, German Ais) only used for Do Re Mi. -->
    <string name="wear_spoken_sharp">%1$s sharp</string>
    <!-- Watch tuner, TalkBack: the name of the small round switch at the bottom of the tuner (a vibrating-watch sign). On, the watch taps the wrist while a note rings so the player can tune without looking: one tap means tighten the string, two taps loosen it, a long buzz means in tune. On by itself while TalkBack is on. The phone's Settings switch of the same name. -->
    <string name="wear_vibration_guide">Vibration guide</string>
    <!-- Microphone permission on the watch. -->
    <string name="wear_mic_needed">Twangle listens to your instrument with the watch\'s microphone.</string>
    <!-- Watch: button under the microphone message that asks for the microphone permission. Short (small round screen). -->
    <string name="wear_allow_mic">Allow microphone</string>
    <!-- Watch: button under the microphone message when the permission was refused for good; opens the watch's app settings. Short. -->
    <string name="wear_open_settings">Open settings</string>
    <!-- When the microphone can't be used. -->
    <string name="wear_mic_busy">Another app is using the microphone.</string>
    <!-- Watch: message when the microphone can't be started for another reason (not busy, not refused). -->
    <string name="wear_mic_unavailable">The microphone can\'t be opened.</string>
    <!-- Watch: button under a microphone message that tries to start listening again. Short. -->
    <string name="wear_try_again">Try again</string>
    <!-- Watch tile (the screen beside the watch face): the button along its bottom edge that opens the tuner. One short word. -->
    <string name="wear_tile_tune">Tune</string>
    <!-- Watch tile: the name on the wide button above Tune that opens the metronome (Phase 80). One word, as the phone's Metronome tab. -->
    <string name="wear_tile_metronome">Metronome</string>
    <!-- Watch tile: small under "Metronome" on its button, the tempo the metronome will start at. %1$d is the number of beats per minute, e.g. "96 BPM". Kept as "BPM" in every language, as on the phone. -->
    <string name="wear_tile_tempo" translatable="false">%1$d BPM</string>
    <!-- Watch tile, TalkBack: the name of the Metronome button. %1$s is the tempo in words (the text "96 beats per minute"), e.g. "Open the metronome, 96 beats per minute". -->
    <string name="wear_tile_open_metronome">Open the metronome, %1$s</string>
    <!-- Watch-face shortcut: the word under Twangle's mark in a small round slot of the watch face; a tap opens the tuner. At most 5 letters: watch faces cut longer words. -->
    <string name="wear_shortcut_tune">Tune</string>
    <!-- Watch: what the tile and the watch-face shortcut do, read by TalkBack and shown in the watch's tile list. -->
    <string name="wear_shortcut_open">Open the tuner</string>
    <!-- Watch metronome: small under the big tempo number, what it counts (beats per minute). Kept as "BPM" in every language, as on the phone. -->
    <string name="wear_metronome_bpm" translatable="false">BPM</string>
    <!-- Watch metronome, TalkBack: the tempo read aloud. %1$d is the number of beats per minute, e.g. "96 beats per minute". -->
    <plurals name="wear_metronome_tempo">
        <item quantity="one">%1$d beat per minute</item>
        <item quantity="other">%1$d beats per minute</item>
    </plurals>
    <!-- Watch metronome, TalkBack: said after the tempo while the metronome plays ("96 beats per minute, Playing"). -->
    <string name="wear_metronome_playing">Playing</string>
    <!-- Watch metronome, TalkBack: said after the tempo while the metronome is stopped. -->
    <string name="wear_metronome_stopped">Stopped</string>
    <!-- Watch metronome, TalkBack: the name of the round ▶ button that starts the metronome. One word, as on the phone's metronome. -->
    <string name="wear_metronome_start">Start</string>
    <!-- Watch metronome, TalkBack: the name of the round ■ button that stops the metronome. One word. -->
    <string name="wear_metronome_stop">Stop</string>
    <!-- Watch metronome, TalkBack: the name of the small speaker button, a switch: on, the watch's speaker clicks on every beat; off, the beat is only a tap on the wrist. -->
    <string name="wear_metronome_click">Click sound</string>
</resources>
