<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same as backup_rules.xml, for the backup to Google's cloud and for a
     move to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/this_device.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/this_device.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
