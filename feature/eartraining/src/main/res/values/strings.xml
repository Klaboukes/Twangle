<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ear training (Phase 55), a Practice tool. TalkBack: the row of three icons that picks the exercise. -->
    <string name="ear_exercises">Exercise</string>
    <!-- The three exercises, each an icon; TalkBack says these names. Play it back: Twangle plays a note, the player finds it on the instrument. -->
    <string name="ear_exercise_play_back">Play it back</string>
    <string name="ear_exercise_intervals">Intervals</string>
    <!-- As practice_chord_type in the Chords tool. -->
    <string name="ear_exercise_chord_type">Chord type</string>
    <!-- TalkBack: the round play button that sounds the question again. -->
    <string name="ear_replay">Hear it again</string>
    <!-- Play it back: under the play button, the note just heard is to be played on the instrument. -->
    <string name="ear_play_prompt">Play it on your instrument</string>
    <!-- Play it back, in the heard note's place while no note is heard. As the tuner's Listening. -->
    <string name="ear_listening">Listening…</string>
    <!-- TalkBack: the note the microphone hears as the player plays, %1$s its name ("F sharp 3"). -->
    <string name="ear_spoken_heard">Heard: %1$s</string>
    <!-- The quiet count of this visit only, at the end of the exercise row: %1$d right answers of %2$d questions answered. Never saved. -->
    <string name="ear_tally">%1$d of %2$d</string>
    <!-- TalkBack: the same count in words. -->
    <string name="ear_tally_spoken">%1$d right of %2$d</string>
    <!-- The button with a sliders icon at the end of the exercise row (TalkBack), and the title of the panel it opens, where the player picks what the questions ask. -->
    <string name="ear_choices">What is asked</string>
    <!-- In that panel, Play it back: the heading over the three choices of notes asked. -->
    <string name="ear_notes">Notes</string>
    <string name="ear_notes_open_strings">Open strings</string>
    <!-- The notes without a sharp or flat (C D E F G A B) on every string up to the 5th fret. -->
    <string name="ear_notes_naturals">Natural notes to the 5th fret</string>
    <string name="ear_notes_all">Every note to the 12th fret</string>
    <!-- Play it back without the microphone: the status line, then a button that asks for it again or opens Settings. -->
    <string name="ear_mic_off">Microphone is off</string>
    <string name="ear_mic_allow">Allow microphone</string>
    <string name="ear_open_settings">Open settings</string>
    <!-- Play it back with two to four notes in a row: the prompt under the play button, for the notes just heard. -->
    <string name="ear_play_prompt_many">Play them on your instrument</string>
    <!-- Play it back, under the note heard: keep the note sounding until the tuner calls it. -->
    <string name="ear_hold">Hold the note you heard</string>
    <!-- Play it back with notes in a row: which note is being looked for, %1$d of the %2$d notes asked. -->
    <string name="ear_note_of">Note %1$d of %2$d</string>
    <!-- Play it back: the note held is the one asked, shown softly in the in-tune colour. -->
    <string name="ear_right">Right</string>
    <!-- Play it back: the note held is not the one asked; the player plays on (never red). -->
    <string name="ear_not_that_one">Not that one</string>
    <!-- In the What is asked panel, Play it back: the heading over the choice of 1 to 4 notes asked in a row. -->
    <string name="ear_notes_in_row">Notes in a row</string>
    <!-- In that panel: a switch; on, the note asked counts in any octave (a G on any string answers a G). -->
    <string name="ear_any_octave">Any octave counts</string>
</resources>
