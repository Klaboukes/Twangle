<resources>
    <!-- A note name with a sharp or flat, read aloud by TalkBack. %1$s is the letter or syllable,
         e.g. "C", "Sol". Languages that say letter names in one word (see bools.xml) use these
         only for Do Re Mi. -->
    <string name="spoken_sharp">%1$s sharp</string>
    <!-- A note name with a flat, read aloud by TalkBack (e.g. "B flat"). %1$s is the letter or syllable, e.g. "B", "Si". -->
    <string name="spoken_flat">%1$s flat</string>

    <!-- The unit printed on the Classic meter's dial, above the needle's pivot (in capitals, as on a real meter). -->
    <string name="meter_cents_label">CENTS</string>

    <!-- The instrument and tuning button (a headstock, no word) above the tuner's strings and in the
         Practice tools: its name (tooltip, TalkBack) and what a double-tap does. -->
    <string name="instrument_button">Instrument</string>
    <!-- TalkBack: what double-tapping the instrument and tuning button does ("Double-tap to …" is added by Android). -->
    <string name="instrument_button_action">Change instrument or tuning</string>
</resources>
