<resources>

    <string name="mic_permission_title">Twangle inahitaji maikrofoni yako</string>
    <string name="mic_permission_intro">Ili kurekebisha sauti, Twangle husikiliza ala yako. Sauti huchanganuliwa kwenye kifaa chako na hairekodiwi wala kutumwa popote.</string>
    <string name="mic_permission_rationale">Bila maikrofoni Twangle haiwezi kusikia nyuzi zako, kwa hivyo haiwezi kujua kama ziko sawa. Sauti haitoki kamwe kwenye kifaa chako.</string>
    <string name="mic_permission_settings_hint">Ufikiaji wa maikrofoni umezimwa kwa Twangle. Fungua Mipangilio, gusa Ruhusa, kisha Maikrofoni, na uchague Ruhusu tu unapotumia programu.</string>
    <string name="mic_permission_settings_hint_switch">Ufikiaji wa maikrofoni umezimwa kwa Twangle. Fungua Mipangilio, gusa Ruhusa, kisha uwashe Maikrofoni.</string>
    <string name="mic_permission_without_mic">Metronomu na zana za Mazoezi hufanya kazi bila maikrofoni.</string>
    <string name="mic_permission_without_mic_metronome">Metronomu hufanya kazi bila maikrofoni.</string>
    <string name="mic_permission_allow">Ruhusu maikrofoni</string>
    <string name="mic_permission_open_settings">Fungua mipangilio</string>

    <string name="error_mic_permission">Ufikiaji wa maikrofoni umezimwa. Uruhusu tena ili uendelee kurekebisha sauti.</string>
    <string name="error_mic_busy">Simu au programu nyingine inatumia maikrofoni. Ikiacha kutumika, gusa Jaribu tena.</string>
    <string name="error_mic_unavailable">Maikrofoni haikuweza kufunguliwa. Funga programu nyingine zinazoitumia na uguse Jaribu tena, au uwashe upya kifaa chako.</string>
    <string name="error_mic_stopped">Maikrofoni imesimama, labda kwa sababu ya simu au programu nyingine. Gusa Jaribu tena ili uendelee kurekebisha sauti.</string>
    <string name="error_retry">Jaribu tena</string>

