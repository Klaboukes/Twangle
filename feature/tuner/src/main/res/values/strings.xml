<resources>
    <string name="tuner_placeholder_note" translatable="false">♪</string>

    <string name="mic_permission_title">Twangle needs your microphone</string>
    <string name="mic_permission_intro">To tune, Twangle listens to your instrument. Sound is analysed on your phone and never recorded or sent anywhere.</string>
    <string name="mic_permission_rationale">Without the microphone Twangle can\'t hear your strings, so it can\'t tell whether they\'re in tune. Sound never leaves your phone.</string>
    <string name="mic_permission_settings_hint">Microphone access is turned off for Twangle. Open Settings, tap Permissions, then Microphone, and choose Allow.</string>
    <string name="mic_permission_allow">Allow microphone</string>
    <string name="mic_permission_open_settings">Open settings</string>

    <!-- Errors when the microphone can't be used. -->
    <string name="error_mic_permission">Microphone access was turned off. Allow it again to keep tuning.</string>
    <string name="error_mic_busy">Another app is using the microphone. Close it, then try again.</string>
    <string name="error_mic_unavailable">The microphone could not be opened on this phone.</string>
    <string name="error_mic_stopped">The microphone stopped unexpectedly.</string>
    <string name="error_retry">Try again</string>

    <!-- Tuner screen. -->
    <string name="tuner_mode_guitar">Guitar</string>
