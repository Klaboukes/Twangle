<resources>
    <string name="app_name" translatable="false">Twangle</string>
    <!-- Watch tuner: shown while no note is heard. -->
    <string name="wear_play_note">Play a note</string>
    <!-- How far the note is off, under the note name. %1$s is the signed number, e.g. "+12" or "−3". -->
    <plurals name="wear_cents">
        <item quantity="one">%1$s cent</item>
        <item quantity="other">%1$s cents</item>
    </plurals>
    <!-- What TalkBack says while the note is in tune (the ring glows), after the note: "E 2, in tune". Lower case. -->
    <string name="wear_in_tune">in tune</string>
    <!-- Watch, TalkBack: the reading read aloud. %1$s is the note as said ("A sharp", in Dutch "ais"), %2$d its octave, %3$s how far off it is or "in tune", e.g. "A sharp 2, in tune". -->
    <string name="wear_spoken_reading">%1$s %2$d, %3$s</string>
    <!-- Watch, TalkBack: the same while the note is off, with which way to turn the peg. %4$s is "tune up" or "tune down", e.g. "A sharp 2, 12 cents flat, tune up". -->
    <string name="wear_spoken_reading_hint">%1$s %2$d, %3$s, %4$s</string>
    <!-- Watch, TalkBack: how far too low the note is, in the reading read aloud. %1$d is how many cents (hundredths of a semitone). -->
    <plurals name="wear_spoken_cents_flat">
        <item quantity="one">%1$d cent flat</item>
        <item quantity="other">%1$d cents flat</item>
    </plurals>
    <!-- Watch, TalkBack: how far too high the note is, in the reading read aloud. %1$d is how many cents. -->
    <plurals name="wear_spoken_cents_sharp">
        <item quantity="one">%1$d cent sharp</item>
        <item quantity="other">%1$d cents sharp</item>
    </plurals>
    <!-- Watch, TalkBack, after the reading while the note is too low: turn the peg up. Lower case. -->
    <string name="wear_spoken_tune_up">tune up</string>
    <!-- Watch, TalkBack, after the reading while the note is too high: turn the peg down. Lower case. -->
    <string name="wear_spoken_tune_down">tune down</string>
    <!-- Watch, TalkBack: a note name with a sharp read aloud, e.g. "A sharp". %1$s is the letter or syllable ("A", "La"). In languages whose letter names are said in one word (Dutch ais, German Ais) only used for Do Re Mi. -->
    <string name="wear_spoken_sharp">%1$s sharp</string>
    <!-- Microphone permission on the watch. -->
    <string name="wear_mic_needed">Twangle listens to your instrument with the watch\'s microphone.</string>
    <!-- Watch: button under the microphone message that asks for the microphone permission. Short (small round screen). -->
    <string name="wear_allow_mic">Allow microphone</string>
    <!-- Watch: button under the microphone message when the permission was refused for good; opens the watch's app settings. Short. -->
    <string name="wear_open_settings">Open settings</string>
    <!-- When the microphone can't be used. -->
    <string name="wear_mic_busy">Another app is using the microphone.</string>
    <!-- Watch: message when the microphone can't be started for another reason (not busy, not refused). -->
    <string name="wear_mic_unavailable">The microphone can\'t be opened.</string>
    <!-- Watch: button under a microphone message that tries to start listening again. Short. -->
    <string name="wear_try_again">Try again</string>
    <!-- Watch tile (the screen beside the watch face): the button along its bottom edge that opens the tuner. One short word. -->
    <string name="wear_tile_tune">Tune</string>
    <!-- Watch-face shortcut: the word under Twangle's mark in a small round slot of the watch face; a tap opens the tuner. At most 5 letters: watch faces cut longer words. -->
    <string name="wear_shortcut_tune">Tune</string>
    <!-- Watch: what the tile and the watch-face shortcut do, read by TalkBack and shown in the watch's tile list. -->
    <string name="wear_shortcut_open">Open the tuner</string>
</resources>
