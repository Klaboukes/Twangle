<resources>
    <!-- Title at the top of the Settings screen. -->
    <string name="settings_title">Settings</string>
    <!-- TalkBack name of the back arrow at the top of Settings' sub-pages (About): goes back to Settings. -->
    <string name="settings_back">Back</string>

    <!-- Group headings. -->
    <string name="settings_group_pitch">Pitch and notes</string>
    <!-- Settings group heading over the style, light or dark, and wallpaper colours. -->
    <string name="settings_group_look">Look</string>
    <!-- Settings group heading over what the tuner screen shows: the meter, its in-tune glow, what is below the note, focus mode. -->
    <string name="settings_group_tuner_screen">Tuner screen</string>
    <!-- Settings group heading over what happens while tuning: keep screen on, vibration, the tune up/down hint, signal bars. -->
    <string name="settings_group_while_tuning">While tuning</string>

    <!-- A4 calibration. -->
    <string name="settings_a4_title">Reference pitch (A4)</string>
    <!-- Reference pitch: the value right of its title, in the accent colour. %1$d is the frequency in hertz, e.g. 440. Must stay on one line; keep the no-break space before Hz. -->
    <string name="settings_a4_value">%1$d\u00A0Hz</string>
    <!-- Reference pitch: the explanation under its title. Keep the numbers and Hz. -->
    <string name="settings_a4_summary">Most music uses 440\u00A0Hz. Orchestras often tune to 442\u00A0Hz, baroque ensembles to 415\u00A0Hz.</string>
    <!-- TalkBack name of the − button by the reference pitch: one hertz lower. -->
    <string name="settings_a4_lower">Lower A4 by 1\u00A0Hz</string>
    <!-- TalkBack name of the + button by the reference pitch: one hertz higher. -->
    <string name="settings_a4_raise">Raise A4 by 1\u00A0Hz</string>
    <!-- Reference pitch: text button that puts it back to the standard. %1$d is 440. -->
    <string name="settings_a4_reset">Reset to %1$d\u00A0Hz</string>

    <!-- Notation. -->
    <string name="settings_notation_title">Note names</string>
    <!-- Note names choice (radio button): note names with sharps, a few shown as a sample. -->
    <string name="settings_notation_sharps">Sharps: C, C♯, D …</string>
    <!-- Note names choice (radio button): note names with flats, a few shown as a sample. -->
    <string name="settings_notation_flats">Flats: C, D♭, D …</string>
    <!-- Note names choice (radio button): the fixed Do Re Mi syllables, a few shown as a sample. Keep the syllables as your language writes them. -->
    <string name="settings_notation_solfege">Do Re Mi: Do, Do♯, Re …</string>
    <!-- Note names choice (radio button), first in the list: the names this language usually uses. %1$s is a sample of those names, e.g. "C, C♯, D … B". -->
    <string name="settings_notation_automatic">Automatic: %1$s</string>
    <!-- A few note names to show a notation by, B's last: "C, C♯, D … B". -->
    <string name="settings_notation_sample">%1$s, %2$s, %3$s … %4$s</string>
    <!-- Note names choice (radio button): the German letters, where B is called H. Keep the letters. -->
    <string name="settings_notation_german">German: C, C♯, D … H</string>

    <!-- In-tune precision: how close a note has to be to count as in tune. -->
    <string name="settings_in_tune_precision_title">In-tune precision</string>
    <!-- In-tune precision choice (radio button): a note counts as in tune within 5 cents (hundredths of a semitone). -->
    <string name="settings_in_tune_precision_relaxed">Relaxed: within 5 cents</string>
    <!-- In-tune precision choice (radio button): a note counts as in tune only within 2 cents. -->
    <string name="settings_in_tune_precision_precise">Precise: within 2 cents</string>

    <!-- Look. -->
    <string name="settings_style_title">Style</string>
    <!-- Setting title over the light, dark and system default choices. -->
    <string name="settings_theme_title">Light or dark</string>
    <!-- Light or dark choice (radio button): follow the phone's own light or dark setting. -->
    <string name="settings_theme_system">System default</string>
    <!-- Light or dark choice (radio button): always the light look. -->
    <string name="settings_theme_light">Light</string>
    <!-- Light or dark choice (radio button): always the dark look. -->
    <string name="settings_theme_dark">Dark</string>
    <!-- Switch title (Contemporary style only): take the app's colours from the phone's wallpaper (Android's Material You). -->
    <string name="settings_dynamic_color_title">Wallpaper colours</string>
    <!-- The line under the Wallpaper colours switch. -->
    <string name="settings_dynamic_color_summary">Use colours from your wallpaper</string>

    <!-- Meter: the look of the meter above the note (in the Tuner screen group). -->
    <string name="settings_meter_look_title">Meter</string>
    <!-- Meter look, the name under its card: a needle on a numbered dial, as on an analogue meter. Shown on one line. -->
    <string name="settings_meter_look_classic">Classic</string>
    <!-- Meter look, the name under its card: a fan of little lights, like an LED pedal tuner. Shown on one line. -->
    <string name="settings_meter_look_light_arc">Light arc</string>
    <!-- Meter look, the name under its card: two triangular pointers, a fixed one above a straight scale and the note's one sliding below it; in tune their tips meet. Shown on one line. -->
    <string name="settings_meter_look_pointers">Pointers</string>
    <!-- Meter look, the name under its card: a moon that covers the sun when in tune, like a solar eclipse. Shown on one line. -->
    <string name="settings_meter_look_eclipse">Eclipse</string>
    <!-- Meter look, the name under its card: chevrons each side that light towards the middle, as on a pedal tuner. Shown on one line. -->
    <string name="settings_meter_look_arrows">Arrows</string>
    <!-- Meter look, the name under its card: a row of bars that light up around the note, as on a pedal tuner. Shown on one line. -->
    <string name="settings_meter_look_light_bars">Light bars</string>
    <!-- Setting title over Calm and Bold: how the meter glows when the note is in tune. -->
    <string name="settings_in_tune_effect_title">In-tune effect</string>
    <!-- The line under In-tune effect. -->
    <string name="settings_in_tune_effect_summary">How strongly the meter glows when a note is in tune</string>
    <!-- In-tune effect choice (radio button): a soft glow. One short word. -->
    <string name="settings_in_tune_effect_calm">Calm</string>
    <!-- In-tune effect choice (radio button): a strong glow. One short word. -->
    <string name="settings_in_tune_effect_bold">Bold</string>

    <!-- Display: what shows how far off a note is, under the note (in the Tuner screen group). -->
    <string name="settings_display_title">Below the note</string>
    <!-- Below the note choice (radio button): the number of cents the note is off. -->
    <string name="settings_display_numbers">Numbers: how many cents off</string>
    <!-- Below the note choice (radio button): a moving picture that slows and stops when in tune, in the wave look picked below. -->
    <string name="settings_display_wave">Wave: a moving picture, in the look you pick</string>
    <!-- Title over the card grid of wave looks (the moving picture below the note). -->
    <string name="settings_wave_look_title">Wave look</string>
    <!-- Wave look, the name under its card: a pattern that drifts until in tune, as on a strobe tuner. Shown on one line. -->
    <string name="settings_wave_look_strobe">Strobe</string>
    <!-- Wave look, the name under its card: a ribbon whose pulses drift and smooth out in tune. Shown on one line. -->
    <string name="settings_wave_look_ribbon">Ribbon</string>
    <!-- Wave look, the name under its card: a scrolling dot-matrix strip. Shown on one line. -->
    <string name="settings_wave_look_dots">Dots</string>
    <!-- Wave look, the name under its card: glowing specks that glide into a line in tune. Shown on one line. -->
    <string name="settings_wave_look_fireflies">Fireflies</string>
    <!-- Wave look, the name under its card: a hoop spinning like a coin until in tune. Shown on one line. -->
    <string name="settings_wave_look_loop">Loop</string>
    <!-- Wave look, the name under its card: rings spreading as on water. Shown on one line. -->
    <string name="settings_wave_look_ripples">Ripples</string>
    <!-- Switch title: focus mode, the tuner sideways full screen with one big meter. -->
    <string name="settings_focus_mode_title">Focus mode</string>
    <!-- The line under the Focus mode switch. -->
    <string name="settings_focus_mode_summary">Turns Twangle on its side with one big meter, easy to read from a distance</string>
    <!-- Switch title: draw charts for left-handed players. -->
    <string name="settings_left_handed_title">Left-handed</string>
    <!-- The line under the Left-handed switch: Practice's chord charts and scale neck are mirrored. -->
    <string name="settings_left_handed_summary">Chord charts and the scale neck drawn for a guitar held the other way round</string>

    <!-- While tuning. -->
    <string name="settings_keep_screen_on_title">Keep screen on</string>
    <!-- The line under the Keep screen on switch. -->
    <string name="settings_keep_screen_on_summary">The screen stays on while you tune</string>
    <!-- Switch title: the phone vibrates briefly when the note gets in tune. -->
    <string name="settings_vibrate_in_tune_title">Vibrate when in tune</string>
    <!-- The line under the Vibrate when in tune switch. -->
    <string name="settings_vibrate_in_tune_summary">A short buzz when the note reaches pitch</string>
    <!-- Switch title: show the hint under the meter that says whether to tune up or down. -->
    <string name="settings_show_tune_hint_title">Show tune up/down hint</string>
    <!-- The line under the tune up/down hint switch. The peg is the tuning peg (machine head) on the instrument's head. -->
    <string name="settings_show_tune_hint_summary">Says which way to turn the peg while a note is off pitch</string>
    <!-- Switch title: show small bars by the note for how loud and clear the sound is heard. -->
    <string name="settings_show_signal_bars_title">Show signal bars</string>
    <!-- The line under the Show signal bars switch. -->
    <string name="settings_show_signal_bars_summary">For the curious: small bars by the note show how well the tuner hears you. Tap them for the figures</string>

    <!-- About (the last group). -->
    <string name="settings_language_title">Language</string>
    <!-- Language setting: the first choice in its list (and the value under the title when picked): follow the phone's own language. -->
    <string name="settings_language_phone">Phone\'s language</string>
    <!-- Button of the language list's dialog: closes it without changing the language. Short. -->
    <string name="settings_language_cancel">Cancel</string>
    <!-- Settings row that starts the tuner's guided tour again. -->
    <string name="settings_show_tour_title">Show me around</string>
    <!-- The line under Show me around. -->
    <string name="settings_show_tour_summary">A short tour of the tuner</string>
    <!-- The last Settings row that opens the About page, and that page's title. -->
    <string name="about_title">About Twangle</string>
    <!-- The line under About Twangle in Settings. %1$s is the version, e.g. "1.0.2". -->
    <string name="settings_about_link_summary">Version %1$s, help, privacy and licences</string>
    <string name="settings_about_app_name" translatable="false">Twangle</string>
    <!-- About page: the version line under the app's name. %1$s is the version, e.g. "1.0.2". -->
    <string name="settings_about_version">Version %1$s</string>
    <!-- About page: heading of the promise that the app stays free. -->
    <string name="settings_about_free_title">Free forever</string>
    <!-- About page: the text under Free forever. -->
    <string name="settings_about_free_summary">No ads, no account, no in-app purchases and no tracking. Not now, not later.</string>
    <!-- About page: heading over the privacy text. -->
    <string name="settings_about_privacy_title">Privacy</string>
    <!-- About page: the privacy text. Keep it as exact as the English; it matches the published privacy policy. -->
    <string name="settings_about_privacy_summary">Twangle collects no data about you. The microphone is only on while a screen that listens is open: the tuner, the metronome\'s Listen or Ear training\'s Play it back. The sound is analysed live and never recorded, saved or sent. Twangle has no internet permission, so it cannot send anything anywhere. Your settings stay on this device (and in Android\'s own backup, if you have turned it on).</string>
    <!-- About page: row that opens the app's Google Play page to rate it. -->
    <string name="settings_about_rate_title">Rate Twangle</string>
    <!-- About page: the line under Rate Twangle. Keep "Google Play" as is. -->
    <string name="settings_about_rate_summary">Twangle on Google Play</string>
    <!-- About page: row that opens the app's website (help on each tool, common questions). -->
    <string name="settings_about_website_title">Help &amp; website</string>
    <!-- About page: the line under Help & website. -->
    <string name="settings_about_website_summary">How each tool works, and answers to common questions</string>
    <!-- About page: heading over the list of fonts and open-source libraries the app uses. -->
    <string name="settings_about_credits_title">Fonts and open-source software</string>
    <!-- About page: the line under that heading. -->
    <string name="settings_about_credits_summary">Twangle is made with these. Tap one to read its licence.</string>
    <!-- TalkBack: what tapping a font or library row does ("Double-tap to …" is added by Android). -->
    <string name="settings_about_licence_open">Read the licence</string>
    <!-- Button of the licence text's dialog: closes it. Short. -->
    <string name="settings_about_licence_close">Close</string>
</resources>
