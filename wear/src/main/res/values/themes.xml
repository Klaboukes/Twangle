<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; the real UI is Compose for Wear OS. -->
    <style name="Theme.Twangle.Watch" parent="@android:style/Theme.DeviceDefault" />

    <!-- Launch theme: the opening screen (androidx core-splashscreen): the launcher icon, still and 48 dp, on black
         (splash_icon.xml), as Google's Wear OS quality rule WO-V15 asks; no animation, unlike the phone's.
         The icon is round, so Theme.SplashScreen, not its IconBackground variant (Google's splash screen guide).
         WatchActivity.installSplashScreen() switches to Theme.Twangle.Watch afterwards. -->
    <style name="Theme.Twangle.Watch.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Twangle.Watch</item>
    </style>
</resources>
