<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget (TuningWidget), the top of the tuner in small (2.0, Phase 75): the
     instrument and tuning in the tuner's picker chip ("Guitar · Standard": ink on the surface, in a
     pill with a fine line round it) and "Open the tuner" under it in the quiet face of the tuner's
     word ("Play a string"), muted, both centred on a rounded tile in the app's background. The whole
     tile opens the tuner. The texts and colours here are the widget picker's preview; TuningWidget
     sets the real ones. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_backdrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- The chip: its line, its fill 1 dp inside it, the name on top. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/widget_chip_line"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_chip_line" />

            <ImageView
                android:id="@+id/widget_chip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="1dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/widget_chip" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/widget_preview_title"
                android:textColor="@color/widget_ink"
                android:textSize="14sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_open_tuner"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
