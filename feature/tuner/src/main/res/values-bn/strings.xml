<resources>
    <string name="mic_permission_title">Twangle-এর আপনার মাইক্রোফোন দরকার</string>
    <string name="mic_permission_intro">টিউন করতে Twangle আপনার বাদ্যযন্ত্র শোনে। আওয়াজ আপনার ডিভাইসেই বিশ্লেষণ করা হয়, কখনো রেকর্ড করা হয় না বা কোথাও পাঠানো হয় না।</string>
    <string name="mic_permission_rationale">মাইক্রোফোন ছাড়া Twangle আপনার তার শুনতে পায় না, তাই সেগুলো সুরে আছে কি না বলতে পারে না। আওয়াজ কখনো আপনার ডিভাইসের বাইরে যায় না।</string>
    <string name="mic_permission_settings_hint">Twangle-এর জন্য মাইক্রোফোনের অনুমতি বন্ধ আছে। সেটিংস খুলুন, অনুমতিতে ট্যাপ করুন, তারপর মাইক্রোফোনে, আর শুধু অ্যাপ ব্যবহারের সময় অনুমতি দিন।</string>
    <string name="mic_permission_settings_hint_switch">Twangle-এর জন্য মাইক্রোফোনের অনুমতি বন্ধ আছে। সেটিংস খুলুন, অনুমতিতে ট্যাপ করুন, আর মাইক্রোফোন চালু করুন।</string>
    <string name="mic_permission_without_mic">মেট্রোনোম আর অনুশীলনের টুলগুলো মাইক্রোফোন ছাড়াই কাজ করে।</string>
    <string name="mic_permission_without_mic_metronome">মেট্রোনোম মাইক্রোফোন ছাড়াই কাজ করে।</string>
