<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The meter picker at the top: one button per time signature. -->
    <string name="metronome_beats_in_bar">Beats in a bar</string>
    <!-- The tempo ruler under the big tempo number (a scale of marks you drag sideways to set the tempo), for TalkBack: its name only (TalkBack itself says how to change it, and says the value from metronome_tempo_value). -->
    <string name="metronome_tempo">Tempo</string>
    <!-- TalkBack: the tempo ruler's value. %1$d is the number of beats per minute, %2$s the Italian tempo marking (e.g. "Andante", not translated). -->
    <plurals name="metronome_tempo_value">
        <item quantity="one">%1$d beat per minute, %2$s</item>
        <item quantity="other">%1$d beats per minute, %2$s</item>
    </plurals>
    <string name="metronome_bpm" translatable="false">BPM</string>
    <!-- Under the big tempo number at the top of the metronome: what the number counts, then the Italian tempo marking (%1$s, e.g. "Allegro", not translated). A label for the number, so it needn't agree with it grammatically. Example: "beats per minute · Allegro". -->
    <string name="metronome_tempo_line">beats per minute · %1$s</string>
    <!-- TalkBack name of the round − button left of the big tempo number: one beat per minute slower. -->
    <string name="metronome_slower">Slower</string>
    <!-- TalkBack name of the round + button right of the big tempo number: one beat per minute faster. -->
    <string name="metronome_faster">Faster</string>
    <!-- The big button beside Start (a fingertip icon and these words): tap it in time with the music and the tempo follows your taps. Short: it shares a row with Start on a small phone. -->
    <string name="metronome_tap">Tap the beat</string>
    <!-- The big accent button (a play icon and this word) that starts the clicks. -->
    <string name="metronome_start">Start</string>
    <!-- The big accent button while the clicks play (a stop icon and this word): stops them. -->
    <string name="metronome_stop">Stop</string>
    <!-- Switch in the options panel: the phone vibrates on every beat as well. Also TalkBack's name for its small icon on the status line under the beat lights while it is on. -->
    <string name="metronome_vibrate">Vibrate on the beat</string>
    <!-- The heading over the row of four click sounds (icons, no words) at the top of the metronome's options panel, and TalkBack's name for that row. -->
    <string name="metronome_sound">Sound</string>
    <!-- The four click sounds, icons in a row on the metronome screen: each instrument's common name, for TalkBack. -->
    <string name="metronome_sound_wood_block">Wood block</string>
    <!-- Click sound (TalkBack): the cowbell (percussion instrument). -->
    <string name="metronome_sound_cowbell">Cowbell</string>
    <!-- Click sound (TalkBack): claves (two wooden sticks struck together). -->
    <string name="metronome_sound_claves">Claves</string>
    <!-- Click sound (TalkBack): a rim click (a drumstick laid on the snare drum, its rim struck). -->
    <string name="metronome_sound_rim_click">Rim click</string>
    <!-- The options panel: the small heading over the four choices of soft clicks the metronome plays between its beats (note-value icons: none, eighths, triplets, sixteenths), and TalkBack's name for that group. "Beat" as in counting the beats of a bar. -->
    <string name="metronome_subdivision">Between the beats</string>
    <!-- Between the beats (TalkBack name of a single-note icon in the options panel): no clicks between the beats, only the beats themselves. -->
    <string name="metronome_subdivision_none">None</string>
    <!-- Between the beats (TalkBack name of an icon of two beamed notes): one soft click halfway between beats, eighth notes (quavers). -->
    <string name="metronome_subdivision_eighths">Eighths</string>
    <!-- Between the beats (TalkBack name of an icon of three beamed notes with a 3): three even clicks per beat, triplets. -->
    <string name="metronome_subdivision_triplets">Triplets</string>
    <!-- Between the beats (TalkBack name of an icon of beamed notes with two beams): sixteenth notes (semiquavers), four clicks per beat; in 6/8 and 7/8 two per beat, which there are sixteenths too. -->
    <string name="metronome_subdivision_sixteenths">Sixteenths</string>
    <!-- TalkBack name of the small note icon on the status line under the beat lights while eighths click between the beats. -->
    <string name="metronome_subdivision_eighths_on">Eighths between the beats</string>
    <!-- TalkBack name of the small note icon on the status line under the beat lights while triplets click between the beats. -->
    <string name="metronome_subdivision_triplets_on">Triplets between the beats</string>
    <!-- TalkBack name of the small note icon on the status line under the beat lights while sixteenths click between the beats. -->
    <string name="metronome_subdivision_sixteenths_on">Sixteenths between the beats</string>
    <!-- TalkBack name of the button in the metronome's top right corner (a ⋯ icon, no word shown): opens the panel with the click sound, the clicks between the beats, Vibrate on the beat, the speed trainer and Listen. Also the panel's name. -->
    <string name="metronome_options">Options</string>

    <!-- The speed trainer: the metronome starts slower and speeds up step by step to a goal tempo, for practising a fast passage. Its row in the metronome's options panel and, while it is on, on a card at the foot of the metronome screen (with a switch and a rising-line icon), the heading of its settings, and TalkBack's name for its switch. -->
    <string name="metronome_trainer">Speed trainer</string>
    <!-- Speed trainer settings: the label of the tempo it starts at (a number with − and + beside it). -->
    <string name="metronome_trainer_start">Start tempo</string>
    <!-- Speed trainer settings: the label of the tempo it climbs to and then holds (a number with − and + beside it). -->
    <string name="metronome_trainer_goal">Goal</string>
    <!-- TalkBack name of the − beside the speed trainer's start tempo: start 5 beats per minute slower. -->
    <string name="metronome_trainer_start_slower">Lower start tempo</string>
    <!-- TalkBack name of the + beside the speed trainer's start tempo: start 5 beats per minute faster. -->
    <string name="metronome_trainer_start_faster">Higher start tempo</string>
    <!-- TalkBack name of the − beside the speed trainer's goal tempo: a goal 5 beats per minute slower. -->
    <string name="metronome_trainer_goal_slower">Lower goal</string>
    <!-- TalkBack name of the + beside the speed trainer's goal tempo: a goal 5 beats per minute faster. -->
    <string name="metronome_trainer_goal_faster">Higher goal</string>
    <!-- Speed trainer settings: the small heading over the four choices of how many beats per minute each step adds (+1, +2, +5, +10), and TalkBack's name for that group. -->
    <string name="metronome_trainer_step">Step</string>
    <!-- Speed trainer: a step in beats per minute with its plus sign, as on its buttons and the status line ("+5"). %1$s is the number. -->
    <string name="metronome_trainer_plus">+%1$s</string>
    <!-- Speed trainer settings: the small heading over the four choices of how many bars each tempo lasts before the next step (1, 2, 4, 8), and TalkBack's name for that group. "Bar" as in a bar (measure) of music. -->
    <string name="metronome_trainer_bars">Bars</string>
    <!-- TalkBack name of a bar-count button in the speed trainer's settings (it shows only the number). %1$s is the number of bars. -->
    <plurals name="metronome_trainer_bars_value">
        <item quantity="one">%1$s bar</item>
        <item quantity="other">%1$s bars</item>
    </plurals>
    <!-- Under "Speed trainer" on its row: the tempo it starts at or plays now, an arrow, the goal tempo, then what comes next. %1$s the tempo now, %2$s the goal, %3$s one of the texts below (e.g. "+5 in 2 bars"). Example: "95 → 120 · +5 in 2 bars". -->
    <string name="metronome_trainer_line">%1$s → %2$s · %3$s</string>
    <!-- The end of the speed trainer's line while it climbs: the next step and in how many bars it comes. %1$s the step with its plus sign ("+5"), %2$s the number of bars. -->
    <plurals name="metronome_trainer_next">
        <item quantity="one">%1$s in %2$s bar</item>
        <item quantity="other">%1$s in %2$s bars</item>
    </plurals>
    <!-- The end of the speed trainer's line while the metronome is stopped: its step and how often. %1$s the step with its plus sign ("+5"), %2$s the number of bars. -->
    <plurals name="metronome_trainer_every">
        <item quantity="one">%1$s every bar</item>
        <item quantity="other">%1$s every %2$s bars</item>
    </plurals>
    <!-- The speed trainer's line once it reached its goal tempo and holds it. %1$s is the tempo. -->
    <string name="metronome_trainer_at_goal">At the goal · %1$s BPM</string>
    <!-- TalkBack: the speed trainer's row while it climbs. %1$s the tempo now, %2$s the goal tempo, %3$s the next step (e.g. "+5 in 2 bars"). -->
    <string name="metronome_trainer_spoken_climbing">Speed trainer, %1$s BPM, climbing to %2$s, %3$s</string>
    <!-- TalkBack: the speed trainer's row while the metronome is stopped. %1$s the start tempo, %2$s the goal tempo, %3$s the step and how often (e.g. "+5 every 4 bars"). -->
    <string name="metronome_trainer_spoken_set">Speed trainer, from %1$s to %2$s BPM, %3$s</string>
    <!-- TalkBack: the speed trainer's row once it reached its goal. %1$s is the tempo. -->
    <string name="metronome_trainer_spoken_goal">Speed trainer, at the goal, %1$s BPM</string>

    <!-- The time signatures (drawn from their numbers, see meterLabel) as TalkBack says them (it would read "3/4" as a date or a fraction). -->
    <string name="metronome_meter_2_4_spoken">Two-four time</string>
    <!-- TalkBack: the 3/4 time signature, as a musician says it. -->
    <string name="metronome_meter_3_4_spoken">Three-four time</string>
    <!-- TalkBack: the 4/4 time signature, as a musician says it. -->
    <string name="metronome_meter_4_4_spoken">Four-four time</string>
    <!-- TalkBack: the 5/4 time signature, as a musician says it. -->
    <string name="metronome_meter_5_4_spoken">Five-four time</string>
    <!-- TalkBack: the 6/8 time signature, as a musician says it. -->
    <string name="metronome_meter_6_8_spoken">Six-eight time</string>
    <!-- TalkBack: the 7/8 time signature, as a musician says it. -->
    <string name="metronome_meter_7_8_spoken">Seven-eight time</string>

    <!-- Italian tempo markings under the big tempo number: the same in every language. -->
    <string name="metronome_marking_grave" translatable="false">Grave</string>
    <string name="metronome_marking_largo" translatable="false">Largo</string>
    <string name="metronome_marking_larghetto" translatable="false">Larghetto</string>
    <string name="metronome_marking_adagio" translatable="false">Adagio</string>
    <string name="metronome_marking_andante" translatable="false">Andante</string>
    <string name="metronome_marking_moderato" translatable="false">Moderato</string>
    <string name="metronome_marking_allegro" translatable="false">Allegro</string>
    <string name="metronome_marking_presto" translatable="false">Presto</string>
    <string name="metronome_marking_prestissimo" translatable="false">Prestissimo</string>

    <!-- Listen (Phase 27): the row in the options panel, beside a microphone icon, that listens to music nearby and suggests its tempo. -->
    <string name="metronome_listen">Listen</string>
    <!-- The options panel's Listen row while it listens (a tap stops it); also TalkBack's name for Stop on the status line. -->
    <string name="metronome_listen_stop_spoken">Stop listening</string>
    <!-- The status line while listening; the tempo it is settling on may follow ("Listening… 96 BPM"). -->
    <string name="metronome_listening">Listening…</string>
    <!-- Action after "Listening… 96 BPM" on the same status line: stops listening. Short, one word if it can. -->
    <string name="metronome_listen_line_stop">Stop</string>
    <!-- The suggestion balloon's heading over the tempo heard; also its TalkBack title. -->
    <string name="metronome_heard">Heard</string>
    <!-- The balloon's button that sets the suggested tempo. -->
    <string name="metronome_use">Use</string>
    <!-- The balloon's button that closes it without changing anything. -->
    <string name="metronome_not_now">Not now</string>
    <!-- TalkBack's name for the balloon's ½× 1× 2× choice. -->
    <string name="metronome_listen_speed">Speed</string>
    <!-- TalkBack's names for ½×, 1× and 2× in the balloon. -->
    <string name="metronome_pick_half">Half</string>
    <!-- TalkBack: the 1× choice in the Listen balloon: use the tempo as it was heard. -->
    <string name="metronome_pick_as_heard">As heard</string>
    <!-- TalkBack: the 2× choice in the Listen balloon: twice the tempo heard. -->
    <string name="metronome_pick_double">Double</string>
    <!-- The status line when listening heard no steady beat; Try again follows it on the same line. -->
    <string name="metronome_no_beat">No steady beat heard</string>
    <!-- Action after "No steady beat heard" or "Microphone is busy" on the same status line: listens again. Short. -->
    <string name="metronome_try_again">Try again</string>
    <!-- The status line when listening couldn't open the microphone (a call or another app has it); Try again follows it on the same line. -->
    <string name="metronome_mic_busy">Microphone is busy</string>
    <!-- The status line when the microphone was refused; Open settings may follow it on the same line. -->
    <string name="metronome_mic_off">Microphone is off</string>
    <!-- Action after "Microphone is off" on the same status line: opens the app's system settings. Short. -->
    <string name="metronome_open_settings">Open settings</string>
</resources>
