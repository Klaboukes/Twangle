<resources>
    <string name="mic_permission_title">Twangle skal bruge din mikrofon</string>
    <string name="mic_permission_intro">For at stemme lytter Twangle til dit instrument. Lyden analyseres på din enhed og bliver aldrig optaget eller sendt nogen steder hen.</string>
    <string name="mic_permission_rationale">Uden mikrofonen kan Twangle ikke høre dine strenge, så den kan ikke se, om de er stemt. Lyden forlader aldrig din enhed.</string>
    <string name="mic_permission_settings_hint">Mikrofonadgang er slået fra for Twangle. Åbn Indstillinger, tryk på Tilladelser og derefter Mikrofon, og vælg Tillad kun, mens appen er i brug.</string>
    <string name="mic_permission_settings_hint_switch">Mikrofonadgang er slået fra for Twangle. Åbn Indstillinger, tryk på Tilladelser, og slå Mikrofon til.</string>
    <string name="mic_permission_without_mic">Metronomen og værktøjerne under Øvelse virker uden mikrofon.</string>
    <string name="mic_permission_without_mic_metronome">Metronomen virker uden mikrofon.</string>
    <string name="mic_permission_allow">Tillad mikrofon</string>
    <string name="mic_permission_open_settings">Åbn indstillinger</string>

    <string name="error_mic_permission">Mikrofonadgang blev slået fra. Tillad den igen for at stemme videre.</string>
    <string name="error_mic_busy">Et opkald eller en anden app bruger mikrofonen. Tryk på Prøv igen, når den er ledig.</string>
    <string name="error_mic_unavailable">Mikrofonen kunne ikke åbnes. Luk andre apps, der bruger den, og tryk på Prøv igen, eller genstart din enhed.</string>
    <string name="error_mic_stopped">Mikrofonen stoppede, måske på grund af et opkald eller en anden app. Tryk på Prøv igen for at stemme videre.</string>
    <string name="error_retry">Prøv igen</string>

