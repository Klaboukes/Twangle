<resources>
    <string name="mic_permission_title">Twangle cần dùng micrô</string>
    <string name="mic_permission_intro">Để lên dây, Twangle nghe nhạc cụ của bạn. Âm thanh được phân tích ngay trên thiết bị và không bao giờ được ghi âm hay gửi đi đâu.</string>
    <string name="mic_permission_rationale">Không có micrô, Twangle không nghe được dây đàn nên không thể biết dây đã chuẩn chưa. Âm thanh không bao giờ rời khỏi thiết bị của bạn.</string>
    <string name="mic_permission_settings_hint">Quyền dùng micrô của Twangle đang tắt. Mở Cài đặt, chạm vào Quyền, rồi Micrô, và chọn Chỉ cho phép khi dùng ứng dụng.</string>
    <string name="mic_permission_settings_hint_switch">Quyền dùng micrô của Twangle đang tắt. Mở Cài đặt, chạm vào Quyền, rồi bật Micrô.</string>
