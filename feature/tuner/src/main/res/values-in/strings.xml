<resources>
    <string name="mic_permission_title">Twangle memerlukan mikrofon Anda</string>
    <string name="mic_permission_intro">Untuk menyetem, Twangle mendengarkan instrumen Anda. Suara dianalisis di perangkat Anda dan tidak pernah direkam atau dikirim ke mana pun.</string>
    <string name="mic_permission_rationale">Tanpa mikrofon, Twangle tidak bisa mendengar senar Anda, jadi tidak bisa tahu apakah senarnya sudah pas. Suara tidak pernah keluar dari perangkat Anda.</string>
    <string name="mic_permission_settings_hint">Akses mikrofon untuk Twangle dinonaktifkan. Buka Setelan, ketuk Izin, lalu Mikrofon, dan izinkan saat aplikasi digunakan.</string>
    <string name="mic_permission_settings_hint_switch">Akses mikrofon untuk Twangle dinonaktifkan. Buka Setelan, ketuk Izin, lalu aktifkan Mikrofon.</string>
    <string name="mic_permission_without_mic">Metronom dan alat Latihan berfungsi tanpa mikrofon.</string>
    <string name="mic_permission_without_mic_metronome">Metronom berfungsi tanpa mikrofon.</string>
