<resources>
    <string name="mic_permission_title">InTune heeft je microfoon nodig</string>
    <string name="mic_permission_intro">Om te stemmen luistert InTune naar je instrument. Het geluid wordt op je telefoon geanalyseerd en nooit opgenomen of verstuurd.</string>
    <string name="mic_permission_rationale">Zonder microfoon kan InTune je snaren niet horen en dus niet zeggen of ze goed gestemd zijn. Het geluid verlaat je telefoon nooit.</string>
    <string name="mic_permission_settings_hint">De microfoon staat uit voor InTune. Open Instellingen, tik op Machtigingen en dan op Microfoon, en kies Toestaan.</string>
    <string name="mic_permission_allow">Microfoon toestaan</string>
    <string name="mic_permission_open_settings">Instellingen openen</string>

    <!-- Errors when the microphone can't be used. -->
    <string name="error_mic_permission">De microfoon is uitgezet. Sta hem weer toe om verder te stemmen.</string>
    <string name="error_mic_busy">Een andere app gebruikt de microfoon. Sluit die app en probeer het opnieuw.</string>
    <string name="error_mic_unavailable">De microfoon kon op deze telefoon niet worden geopend.</string>
    <string name="error_mic_stopped">De microfoon is onverwacht gestopt.</string>
    <string name="error_retry">Opnieuw proberen</string>

