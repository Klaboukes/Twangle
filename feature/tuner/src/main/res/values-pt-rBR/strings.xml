<resources>
    <string name="mic_permission_title">O Twangle precisa do seu microfone</string>
    <string name="mic_permission_intro">Para afinar, o Twangle ouve seu instrumento. O som é analisado no seu dispositivo e nunca é gravado nem enviado.</string>
    <string name="mic_permission_rationale">Sem o microfone, o Twangle não ouve suas cordas e não consegue dizer se estão afinadas. O som nunca sai do seu dispositivo.</string>
    <string name="mic_permission_settings_hint">O acesso ao microfone está desativado para o Twangle. Abra as Configurações, toque em Permissões, depois em Microfone, e permita durante o uso do app.</string>
    <string name="mic_permission_settings_hint_switch">O acesso ao microfone está desativado para o Twangle. Abra as Configurações, toque em Permissões e ative Microfone.</string>
    <string name="mic_permission_without_mic">O metrônomo e as ferramentas de Prática funcionam sem o microfone.</string>
    <string name="mic_permission_without_mic_metronome">O metrônomo funciona sem o microfone.</string>
    <string name="mic_permission_allow">Permitir microfone</string>
    <string name="mic_permission_open_settings">Abrir configurações</string>

    <string name="error_mic_permission">O acesso ao microfone foi desativado. Permita de novo para continuar afinando.</string>
    <string name="error_mic_busy">Uma ligação ou outro app está usando o microfone. Quando ele estiver livre, toque em Tentar de novo.</string>
    <string name="error_mic_unavailable">Não foi possível abrir o microfone. Feche outros apps que o usam e toque em Tentar de novo, ou reinicie o dispositivo.</string>
    <string name="error_mic_stopped">O microfone parou, talvez por uma ligação ou outro app. Toque em Tentar de novo para continuar afinando.</string>
