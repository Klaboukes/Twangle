<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same as backup_rules.xml, for the cloud backup and a move to a new watch. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="twangle_wear.xml" />
        <exclude domain="file" path="datastore/watch_metronome.preferences_pb" />
        <exclude domain="file" path="datastore/watch_tuner.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="twangle_wear.xml" />
        <exclude domain="file" path="datastore/watch_metronome.preferences_pb" />
        <exclude domain="file" path="datastore/watch_tuner.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
