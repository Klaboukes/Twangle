<resources>
    <string name="mic_permission_title">Twangle necesita tu micrófono</string>
    <string name="mic_permission_intro">Para afinar, Twangle escucha tu instrumento. El sonido se analiza en tu dispositivo y nunca se graba ni se envía.</string>
    <string name="mic_permission_rationale">Sin el micrófono, Twangle no puede oír tus cuerdas ni saber si están afinadas. El sonido nunca sale de tu dispositivo.</string>
    <string name="mic_permission_settings_hint">El acceso al micrófono está desactivado para Twangle. Abre Ajustes, toca Permisos, luego Micrófono, y permítelo mientras se usa la aplicación.</string>
    <string name="mic_permission_settings_hint_switch">El acceso al micrófono está desactivado para Twangle. Abre Ajustes, toca Permisos y activa Micrófono.</string>
    <string name="mic_permission_without_mic">El metrónomo y las herramientas de Práctica funcionan sin el micrófono.</string>
    <string name="mic_permission_without_mic_metronome">El metrónomo funciona sin el micrófono.</string>
    <string name="mic_permission_allow">Permitir micrófono</string>
    <string name="mic_permission_open_settings">Abrir ajustes</string>

    <string name="error_mic_permission">Se desactivó el acceso al micrófono. Vuelve a permitirlo para seguir afinando.</string>
    <string name="error_mic_busy">Una llamada u otra app está usando el micrófono. Cuando esté libre, toca Reintentar.</string>
    <string name="error_mic_unavailable">No se pudo abrir el micrófono. Cierra otras apps que lo usen y toca Reintentar, o reinicia tu dispositivo.</string>
    <string name="error_mic_stopped">El micrófono se detuvo, quizá por una llamada u otra app. Toca Reintentar para seguir afinando.</string>
