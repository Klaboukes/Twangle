<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's card: a rounded tile in the style's background colour. TuningWidget tints it with a
     colour filter, so this colour (Contemporary's, light or dark) only shows in the widget picker's preview. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_background" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
