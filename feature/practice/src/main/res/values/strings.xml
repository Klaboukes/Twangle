<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Practice tab: the Chords tool's name (chord charts) on its card and in the "Last time" row. One or two words. -->
    <string name="practice_tool_chords">Chords</string>
    <!-- Practice tab: the Scales tool's name (scales on the neck, with the drone) on its card and in the "Last time" row. One or two words. -->
    <string name="practice_tool_scales">Scales</string>
    <!-- Practice tab (2.0): the line under "Chords" on its big card, saying what the tool does. Short, about five words; it may wrap to two lines. -->
    <string name="practice_card_chords">Every shape, left-handed too</string>
    <!-- Practice tab: the line under "Scales" on its card (scales on the neck; a drone is a held note to play along with). About five words. -->
    <string name="practice_card_scales">With a drone to play along</string>
    <!-- Practice tab: the line under "Capo" on its card (the capo helper says on which fret to put the capo for the key you want). About five words. -->
    <string name="practice_card_capo">Which fret for the key you want</string>
    <!-- Practice tab: the line under "Ear training" on its card (it plays a note, you play it back on the instrument). About five words. -->
    <string name="practice_card_ear_training">Hear a note, play it back</string>
    <!-- Practice tab: small heading of the shortcut above the tools that reopens the tool used most recently, over its name (e.g. "Chords · C major"). -->
    <string name="practice_last_time">Last used</string>
    <!-- Practice tab, the "Last used" row: the tool's name and what was picked in it, e.g. "Chords · C major" or "Scales · A minor pentatonic". -->
    <string name="practice_last_time_detail">%1$s · %2$s</string>
    <!-- TalkBack: the back arrow in the top corner of a Practice tool (Chords, Scales, Capo, Ear training), which leads back to the Practice cards. -->
    <string name="practice_back">Back</string>
    <!-- Phase 55: Ear training, a Practice tool of its own (Play it back, Intervals, Chord type). -->
    <string name="practice_tool_ear_training">Ear training</string>
    <!-- Phase 78: the pitch trail, a Practice tool of its own (a held note drawn as a line, its last seconds falling under it), its name on its card, its top row and the "Last time" row. One or two words. -->
    <string name="practice_tool_pitch_trail">Pitch trail</string>
    <!-- Practice tab: the line under "Pitch trail" on its card (sing or play a long note and see how steady it is, a bend or a vibrato). About five words. -->
    <string name="practice_card_pitch_trail">How steady is your note?</string>
    <!-- Chords (Phase 32): TalkBack, the group of root buttons (C, C♯, D …) the chord is built on. -->
    <string name="practice_root">Root</string>
    <!-- TalkBack, the group of chord type buttons (C, Cm, C7 …). -->
    <string name="practice_chord_type">Chord type</string>
    <!-- A chord in words: the chart's title, and how TalkBack says a chord type button. %1$s is the root ("A", "B♭", "La"). As the tuner's chord name. -->
    <string name="practice_chord_major">%1$s major</string>
    <!-- Chords: a minor (Cm) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_minor">%1$s minor</string>
    <!-- Chords: a seventh (dominant seventh, C7) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_seventh">%1$s seventh</string>
    <!-- Chords: a major seventh (Cmaj7) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_major_seventh">%1$s major seventh</string>
    <!-- Chords: a minor seventh (Cm7) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_minor_seventh">%1$s minor seventh</string>
    <!-- Chords: a suspended second (Csus2) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_sus2">%1$s suspended second</string>
    <!-- Chords: a suspended fourth (Csus4) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_sus4">%1$s suspended fourth</string>
    <!-- Chords: a seventh suspended fourth (C7sus4) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_seventh_sus4">%1$s seventh suspended fourth</string>
    <!-- Chords: a sixth (C6) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_sixth">%1$s sixth</string>
    <!-- Chords: a minor sixth (Cm6) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_minor_sixth">%1$s minor sixth</string>
    <!-- Chords: an added ninth (Cadd9) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_add9">%1$s added ninth</string>
    <!-- Chords: a ninth (C9) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_ninth">%1$s ninth</string>
    <!-- Chords: a diminished (Cdim) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_diminished">%1$s diminished</string>
    <!-- Chords: a diminished seventh (Cdim7) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_diminished_seventh">%1$s diminished seventh</string>
    <!-- Chords: a half-diminished (Cm7b5) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_half_diminished">%1$s half-diminished</string>
    <!-- Chords: an augmented (Caug) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_augmented">%1$s augmented</string>
    <!-- Phase 49: the power chord ("C5"), the 7♯9 ("Hendrix chord"), m9 and maj9. Words for TalkBack, so "sharp" in words, not ♯. -->
    <string name="practice_chord_power_chord">%1$s power chord</string>
    <!-- Chords: a seven sharp nine (C7#9, the "Hendrix chord") in words: the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_seventh_sharp_nine">%1$s seven sharp nine</string>
    <!-- Chords: a minor ninth (Cm9) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_minor_ninth">%1$s minor ninth</string>
    <!-- Chords: a major ninth (Cmaj9) chord in words, the chart's title and TalkBack's name for its button. %1$s is the root ("A", "B♭", "La"). -->
    <string name="practice_chord_major_ninth">%1$s major ninth</string>
    <!-- Between the ‹ › buttons under the chart: shape %1$d of the %2$d found. -->
    <string name="practice_shape_count">%1$d of %2$d</string>
    <!-- TalkBack, the ‹ and › buttons that step through the shapes of the chord. -->
    <string name="practice_shape_previous">Previous shape</string>
    <!-- TalkBack name of the › button under the chord chart: shows the chord's next shape. -->
    <string name="practice_shape_next">Next shape</string>
    <!-- Beside the first fret row of a chart that starts higher up the neck, as songbooks write it ("5fr"). -->
    <string name="practice_chart_fret">%1$dfr</string>
    <!-- In the chart's place when the chord has no comfortable shape in the picked tuning. -->
    <string name="practice_chord_none">No shape within reach in this tuning</string>
    <!-- Capo helper: shown in the table's place for the 5-string banjo, saying why there is no table: the banjo's short fifth string (it starts at the fifth fret) needs a capo of its own, so the table's sums don't hold. The button practice_capo_pick_instrument stands under it. -->
    <string name="practice_capo_short_string">The capo table leaves out the banjo: its short fifth string needs a capo of its own.</string>
    <!-- Capo helper, on the 5-string banjo: the text button under practice_capo_short_string that opens the instrument and tuning panel, to pick an instrument the table knows. Short. -->
    <string name="practice_capo_pick_instrument">Pick another instrument</string>
    <!-- TalkBack: between the parts of a spoken chart. -->
    <string name="practice_spoken_separator">", "</string>
    <!-- TalkBack, a chart: %1$s the chord in words ("C major"), then which shape of how many. -->
    <string name="practice_spoken_shape">%1$s, shape %2$d of %3$d</string>
    <!-- TalkBack: a string by its open note, %1$s e.g. "E 2", as the tuning editor says it. -->
    <string name="practice_spoken_string">%1$s string</string>
    <!-- TalkBack: the 5-string banjo's short fifth string (it starts at the fifth fret) by its open note, %1$s e.g. "G 4", as practice_spoken_string with the word "short": "short G 4 string". -->
    <string name="practice_spoken_short_string">short %1$s string</string>
    <!-- TalkBack, each string of the shape: %1$s the string ("E 2 string"); played strings add the fret, the finger and the note sounded. A barre: its finger, its fret and the first and last string's notes ("A 2", "E 4"). -->
    <string name="practice_spoken_muted">%1$s, not played</string>
    <!-- TalkBack, a string of the chord shape played open: %1$s is the string ("E 2 string"). -->
    <string name="practice_spoken_open">%1$s, open</string>
    <!-- TalkBack, a string of the chord shape: %1$s the string ("E 2 string"), %2$d the fret, %3$d the finger (1 index to 4 little finger), %4$s the note it sounds ("C"). -->
    <string name="practice_spoken_fret">%1$s, fret %2$d, finger %3$d, %4$s</string>
    <!-- TalkBack, a barre (one finger across several strings): %1$d the finger, %2$d the fret, %3$s and %4$s the first and last string's notes ("A 2", "E 4"). Note %2$d comes before %1$d in English. -->
    <string name="practice_spoken_barre">barre, fret %2$d, finger %1$d, strings %3$s to %4$s</string>
    <!-- Scales (Phase 32, a tool of its own since Phase 47): TalkBack, the scale panel's one group of scale buttons (Major, Minor …). -->
    <string name="practice_scale_type">Scale</string>
    <!-- The scale buttons, two to a row, the most used first (long names take two lines, set smaller to fit). Major and Minor are the major and the (natural) minor scale: each language's usual word for them. -->
    <string name="practice_scale_type_major">Major</string>
    <!-- Scales: the button for the natural minor scale, in a grid two to a row (a long name takes two lines). Musicians' usual name. -->
    <string name="practice_scale_type_minor">Minor</string>
    <!-- Scales: the button for the major pentatonic scale, in a grid two to a row (a long name takes two lines). Musicians' usual name. -->
    <string name="practice_scale_type_major_pentatonic">Major pentatonic</string>
    <!-- Scales: the button for the minor pentatonic scale, in a grid two to a row (a long name takes two lines). Musicians' usual name. -->
    <string name="practice_scale_type_minor_pentatonic">Minor pentatonic</string>
    <!-- Scales: the button for the blues scale, in a grid two to a row (a long name takes two lines). Musicians' usual name. -->
    <string name="practice_scale_type_blues">Blues</string>
