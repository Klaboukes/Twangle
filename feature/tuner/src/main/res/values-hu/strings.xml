<resources>

    <string name="mic_permission_title">A hangoláshoz kell a mikrofon</string>
    <string name="mic_permission_intro">A hangoláshoz a Twangle a hangszeredet hallgatja. A hangot a készüléked elemzi, és soha nem rögzíti vagy küldi el sehova.</string>
    <string name="mic_permission_rationale">Mikrofon nélkül a Twangle nem hallja a húrjaidat, így azt sem tudja megmondani, hogy tiszták-e. A hang soha nem hagyja el a készülékedet.</string>
    <string name="mic_permission_settings_hint">A Twangle mikrofonhozzáférése ki van kapcsolva. Nyisd meg a Beállításokat, koppints az Engedélyek, majd a Mikrofon pontra, és válaszd az engedélyezést csak az alkalmazás használata közben.</string>
    <string name="mic_permission_settings_hint_switch">A Twangle mikrofonhozzáférése ki van kapcsolva. Nyisd meg a Beállításokat, koppints az Engedélyek pontra, és kapcsold be a Mikrofont.</string>
    <string name="mic_permission_without_mic">A metronóm és a Gyakorlás eszközei mikrofon nélkül is működnek.</string>
    <string name="mic_permission_without_mic_metronome">A metronóm mikrofon nélkül is működik.</string>
    <string name="mic_permission_allow">Mikrofon engedélyezése</string>
    <string name="mic_permission_open_settings">Beállítások</string>

    <string name="error_mic_permission">A mikrofonhozzáférés ki lett kapcsolva. Engedélyezd újra a hangoláshoz.</string>
    <string name="error_mic_busy">Egy hívás vagy egy másik alkalmazás használja a mikrofont. Ha felszabadult, koppints az Újra gombra.</string>
    <string name="error_mic_unavailable">Nem sikerült megnyitni a mikrofont. Zárd be a mikrofont használó alkalmazásokat, és koppints az Újra gombra, vagy indítsd újra a készüléket.</string>
    <string name="error_mic_stopped">A mikrofon leállt, talán egy hívás vagy egy másik alkalmazás miatt. Koppints az Újra gombra a folytatáshoz.</string>
    <string name="error_retry">Újra</string>

