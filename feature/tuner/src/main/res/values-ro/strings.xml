<resources>
    <string name="mic_permission_title">Twangle are nevoie de microfon</string>
    <string name="mic_permission_intro">Pentru acordare, Twangle ascultă instrumentul. Sunetul este analizat pe dispozitiv și nu este niciodată înregistrat sau trimis.</string>
    <string name="mic_permission_rationale">Fără microfon, Twangle nu vă aude corzile, deci nu poate spune dacă sunt acordate. Sunetul nu părăsește niciodată dispozitivul.</string>
    <string name="mic_permission_settings_hint">Accesul la microfon este dezactivat pentru Twangle. Deschideți Setări, atingeți Permisiuni, apoi Microfon, și alegeți să îl permiteți numai în timp ce folosiți aplicația.</string>
    <string name="mic_permission_settings_hint_switch">Accesul la microfon este dezactivat pentru Twangle. Deschideți Setări, atingeți Permisiuni și activați Microfon.</string>
    <string name="mic_permission_without_mic">Metronomul și funcțiile din Exersare merg fără microfon.</string>
    <string name="mic_permission_without_mic_metronome">Metronomul merge fără microfon.</string>
    <string name="mic_permission_allow">Permiteți microfonul</string>
    <string name="mic_permission_open_settings">Deschideți setările</string>

    <string name="error_mic_permission">Accesul la microfon a fost dezactivat. Permiteți-l din nou pentru a continua acordarea.</string>
    <string name="error_mic_busy">Un apel sau altă aplicație folosește microfonul. Când este liber, atingeți Încercați din nou.</string>
    <string name="error_mic_unavailable">Microfonul nu a putut fi deschis. Închideți alte aplicații care îl folosesc și atingeți Încercați din nou sau reporniți dispozitivul.</string>
    <string name="error_mic_stopped">Microfonul s-a oprit, poate din cauza unui apel sau a altei aplicații. Atingeți Încercați din nou pentru a continua acordarea.</string>
    <string name="error_retry">Încercați din nou</string>

